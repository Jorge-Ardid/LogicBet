# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# --- Local DB artifacts ---
*.db-journal
*.db-wal
*.db-shm

# --- Runtime user data (bets/bankroll) — NEVER overwrite on deploy ---
webapp/user_data.db
webapp/*.db
# Захисні знімки (v30-ізоляція): локальні, змінюються під час роботи —
# git їх НІКОЛИ не повинен бачити (інакше reset --hard перезапише).
webapp/user_data.db.snapshot
webapp/user_data.db.snaptmp
# Шаблон для чистих деплоїв — ТРЕКАЄТЬСЯ (виключення з webapp/*.db).
!webapp/user_data.db.template

# --- Scratch / debug outputs (session helpers) ---
*_out.txt
*_check.txt
*_dump.txt
*_full.txt
done_flag.tmp
_cleanup_report.txt
_lsfiles.txt
_pre_delete_check.txt
conflicts*.txt
git_*.txt
*.log

# --- OS / editor junk ---
.DS_Store
Thumbs.db
